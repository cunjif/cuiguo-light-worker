{
  "name": "markitdown-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for converting documents to Markdown using markitdown-ts",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "markitdown-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && copyfiles -u 1 src/vendor/turndown/**/* src/vendor/domino/**/* src/vendor/papaparse/**/* src/vendor/mammoth/**/* src/vendor/cheerio/**/* src/vendor/jszip/**/* src/vendor/fast-xml-parser/**/* src/vendor/exceljs/**/* src/vendor/pdfjs-dist/**/* src/vendor/mcp-sdk/**/* dist",
    "prepack": "npm run build"
  },
