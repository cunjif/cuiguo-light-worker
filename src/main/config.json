{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./",
        "C:\\",
        "/",
        "*/**"
      ],
      "command": "npx"
    },
    "aigroup-mdtoword-mcp": {
      "args": [
        "-y",
        "aigroup-mdtoword-mcp"
      ],
      "command": "npx"
    },
    "Bazi": {
      "command": "npx",
      "args": [
        "bazi-mcp"
      ]
    },
    "markitdown": {
      "command": "npx",
      "args": [
        "-y",
        "markitdown-mcp-server"
      ]
    },
    "MCPControl": {
      "command": "mcp-control",
      "args": ["--sse"],
      "platform": "win32"
    },
    "LinuxControl": {
      "command": "node",
      "args": ["./mcp-builtin/linux-control/index.js"],
      "platform": "linux"
    }
  }
}