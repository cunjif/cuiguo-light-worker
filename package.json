{
  "name": "cuiguo-light-workstation",
  "version": "1.0.0",
  "author": {
    "name": "",
    "email": "nobug@unknown.com"
  },
  "description": "light workstation for mcp",
  "homepage": "https://github.com/cuiguo/light-workstation",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && electron ./dist/main/main.js",
    "build": "tsc && node scripts/copy-assets.cjs",
    "build-app": "npm run build && electron-builder",
    "pack:mcp": "node scripts/pack-mcp-servers.js",
    "build:with-mcp": "npm run pack:mcp && npm run build-app"
  },
  "build": {
    "appId": "com.cuiguo.lightworkstation",
    "npmRebuild": false,
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "**/*",
      "!src/mcp-builtin/**/*"
    ],
    "extraFiles": [
      {
        "from": "./src/main/config.json",
        "to": "./"
      },
      {
        "from": "./src/mcp-builtin",
        "to": "./mcp-builtin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@eggjs/yauzl": "^2.11.0",
    "@hono/node-server": "^1.19.9",
    "@mixmark-io/domino": "^2.2.0",
    "@xmldom/xmldom": "^0.8.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "archiver": "^5.0.0",
    "argparse": "~1.0.3",
    "base64-js": "^1.5.1",
    "better-sqlite3": "^12.0.0",
    "bluebird": "~3.4.0",
    "buffer-crc32": "^1.0.0",
    "content-type": "^1.0.5",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.5",
    "dayjs": "^1.8.34",
    "dingbat-to-unicode": "^1.0.1",
    "docx-preview": "^0.4.0",
    "eventsource": "^3.0.2",
    "eventsource-parser": "^3.0.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "fast-csv": "^4.3.1",
    "flushwritable": "^1.0.0",
    "get-ready": "^1.0.0",
    "iconv-lite": "^0.5.0",
    "jose": "^6.1.1",
    "json-schema-typed": "^8.0.2",
    "jszip": "^3.10.1",
    "lie": "~3.3.0",
    "lop": "^0.4.2",
    "monaco-editor": "^0.56.0",
    "node-notifier": "^10.0.1",
    "pako": "~1.0.2",
    "path-is-absolute": "^1.0.0",
    "pkce-challenge": "^5.0.0",
    "raw-body": "^3.0.0",
    "readable-stream": "^3.6.0",
    "saxes": "^5.0.1",
    "setimmediate": "^1.0.5",
    "streamifier": "^0.1.1",
    "strnum": "^1.0.5",
    "tar": "^7.5.22",
    "tar-stream": "^1.5.2",
    "tmp": "^0.2.0",
    "underscore": "^1.13.1",
    "unzipper": "^0.10.11",
    "uuid": "^8.3.0",
    "xlsx": "^0.18.5",
    "xmlbuilder": "^10.0.0",
    "yazl": "^2.4.2",
    "zod": "^3.25 || ^4.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node-notifier": "^8.0.5",
    "copyfiles": "^2.4.1",
    "electron": "30.0.1",
    "electron-builder": "^26.15.3",
    "electron-debug": "^4.1.0",
    "typescript": "^5.7.3"
  }
}
