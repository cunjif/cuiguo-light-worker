{
  "name": "cuiguo-light-workstation",
  "version": "1.0.0",
  "author": {
    "name": "",
    "email": "nobug@unknown.com"
  },
  "description": "light workstation for mcp",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && electron ./dist/main/main.js",
    "build": "tsc && copyfiles -u 1 src/**/* -e src/**/*.ts dist",
    "build-app": "npm run build && electron-builder",
    "build:linux": "bash build-linux.sh deb",
    "build:linux:all": "bash build-linux.sh all",
    "build:linux:appimage": "bash build-linux.sh AppImage",
    "pack:mcp": "node scripts/pack-mcp-servers.js",
    "build:with-mcp": "npm run pack:mcp && npm run build-app"
  },
  "build": {
    "appId": "com.cuiguo.lightworkstation",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "**/*"
    ],
    "extraFiles": [
      {
        "from": "./src/main/config.json",
        "to": "./"
      },
      {
        "from": "./src/mcp-builtin",
        "to": "./mcp-builtin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node-notifier": "^8.0.5",
    "copyfiles": "^2.4.1",
    "electron": "^41.10.3",
    "electron-builder": "^26.2.0",
    "electron-debug": "^4.1.0",
    "node-notifier": "^10.0.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {}
}
